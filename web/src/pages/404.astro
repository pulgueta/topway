---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Topway"
  description="This page does not exist on the Topway website."
  noindex
>
  <div class="container not-found">
    <h1>Page not found</h1>
    <p class="lead">There is no page at this address. Make sure that the address is correct.</p>
    <div class="button-row">
      <a class="button button-prominent" href="/">Go to the home page</a>
      <a class="button button-secondary" href="/download">Get Topway</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: clamp(2rem, 1rem + 5vw, 6rem);
  }

  .not-found .lead {
    max-width: 36rem;
  }

  .not-found .button-row {
    margin-top: 0.75rem;
  }
</style>
