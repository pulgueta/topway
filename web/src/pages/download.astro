---
import { appStoreUrl, buildFromSourceUrl, polarUrl } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

// The two ways to get Topway. While a link in src/config.ts is null, the option shows
// "Coming soon" in place of its button.
const options = [
  {
    id: "app-store",
    title: "Mac App Store",
    text: "The App Store installs the updates.",
    button: "View on the Mac App Store",
    href: appStoreUrl,
  },
  {
    id: "dmg",
    title: "Disk image (DMG)",
    text: "Pay one time through Polar. Apple notarizes the DMG. The updates are free, and Topway installs them for you.",
    button: "Buy the DMG",
    href: polarUrl,
  },
];
---

<BaseLayout
  title="Get Topway for Mac"
  description="Get Topway from the Mac App Store or as a notarized disk image (DMG). Topway needs macOS 26.2 or later."
>
  <div class="container page">
    <header class="page-header enter">
      <h1>Get Topway</h1>
      <p class="lead">
        The same app from the Mac App Store or as a disk image (DMG). Topway needs macOS 26.2 or
        later.
      </p>
    </header>

    <div class="options">
      {
        options.map((option) => (
          <section class="option stage" aria-labelledby={`${option.id}-title`}>
            <h2 id={`${option.id}-title`}>{option.title}</h2>
            <p>{option.text}</p>
            <div class="option-action">
              {option.href ? (
                <a class="button button-prominent" href={option.href}>
                  {option.button}
                </a>
              ) : (
                <p class="coming-soon">Coming soon</p>
              )}
            </div>
          </section>
        ))
      }
    </div>

    <div class="fine-print">
      <p>
        Install only one of the two on a Mac. With two copies, the sign-in can stop before it
        finishes.
      </p>
      <p>
        Topway is open source under the MIT license.{" "}
        <a href={buildFromSourceUrl}>Read how to build Topway</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(1.5rem, 1rem + 3vw, 4rem);
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40rem;
  }

  .options {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  @media (min-width: 52rem) {
    .options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .option {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(2.25rem, 1.8rem + 2vw, 3.25rem) clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem)
      clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    color: var(--text);
  }

  .option h2 {
    font-size: clamp(1.5rem, 1.35rem + 0.6vw, 1.875rem);
  }

  .option-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  /* The same size as the button that replaces it, so the layout stays when the owner sets
     the link. */
  .coming-soon {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
  }

  .option p {
    max-width: 34rem;
  }

  .fine-print {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: 40rem;
    margin-top: 1.5rem;
    font-size: var(--step-small);
  }
</style>
