---
import { appStoreUrl, buildFromSourceUrl, polarUrl } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

// The two ways to get Topway. While a link in src/config.ts is null, the option shows
// "Coming soon" in place of its button.
const options = [
  {
    id: "app-store",
    title: "Mac App Store",
    text: "Topway is a paid app on the Mac App Store.",
    button: "View on the Mac App Store",
    href: appStoreUrl,
    note: "The App Store installs the updates.",
  },
  {
    id: "dmg",
    title: "Disk image (DMG)",
    text: "Get Topway as a disk image (DMG). Open it, then drag Topway to the Applications folder.",
    button: "Buy the DMG",
    href: polarUrl,
    note: "Apple notarizes the DMG. Topway finds its updates and installs them for you.",
  },
];
---

<BaseLayout
  title="Get Topway for Mac"
  description="Get Topway from the Mac App Store or as a notarized disk image (DMG). Topway needs macOS 26.2 or later."
>
  <div class="container page">
    <header class="page-header enter">
      <h1>Get Topway</h1>
      <p class="lead">
        You can get Topway in two ways. Both give you the same app in the menu bar of your Mac.
      </p>
    </header>

    <div class="options">
      {
        options.map((option) => (
          <section class="option stage" aria-labelledby={`${option.id}-title`}>
            <h2 id={`${option.id}-title`}>{option.title}</h2>
            <p>{option.text}</p>
            <div class="option-action">
              {option.href ? (
                <a class="button button-prominent" href={option.href}>
                  {option.button}
                </a>
              ) : (
                <p class="coming-soon">Coming soon</p>
              )}
              {option.note && <p class="option-note">{option.note}</p>}
            </div>
          </section>
        ))
      }
    </div>

    <p class="source-note">
      Topway is also open source under the MIT license. You can build it from source at no cost.{" "}
      <a href={buildFromSourceUrl}>Read how to build Topway</a>
    </p>

    <div class="details">
      <section aria-labelledby="requirements-title">
        <h2 id="requirements-title">Requirements</h2>
        <ul>
          <li>A Mac with macOS 26.2 or later.</li>
          <li>
            A Railway account. With no account, you can try Topway with sample data. Select{" "}
            <strong>Try with sample data</strong> on the start screen.
          </li>
        </ul>
      </section>

      <section aria-labelledby="one-copy-title">
        <h2 id="one-copy-title">Install only one copy</h2>
        <p>
          Install Topway from the Mac App Store or from the DMG. Do not install the two on one Mac.
          With two copies, the sign-in can stop before it finishes.
        </p>
        <p>To change from one copy to the other:</p>
        <ol>
          <li>Quit Topway.</li>
          <li>Delete the old copy.</li>
          <li>Install the new copy, then open it.</li>
        </ol>
        <p>
          Your sign-in and your settings stay. Topway can ask for your Mac password one time.
        </p>
      </section>

      <section aria-labelledby="after-title">
        <h2 id="after-title">After you install Topway</h2>
        <p>
          Open Topway. Its icon is in the menu bar at the top of the screen, not in the Dock. At the
          first launch, a welcome window shows what Topway does and where its icon is.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(1.5rem, 1rem + 3vw, 4rem);
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40rem;
  }

  .options {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  @media (min-width: 52rem) {
    .options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .option {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(2.25rem, 1.8rem + 2vw, 3.25rem) clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem)
      clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    color: var(--text);
  }

  .option h2 {
    font-size: clamp(1.5rem, 1.35rem + 0.6vw, 1.875rem);
  }

  .option-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  /* The same size as the button that replaces it, so the layout stays when the owner sets
     the link. */
  .coming-soon {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
  }

  .option-note {
    max-width: 30rem;
    font-size: var(--step-small);
  }

  .source-note {
    margin-top: 1.5rem;
    max-width: 44rem;
  }

  .details {
    display: grid;
    gap: 3rem clamp(2rem, 5vw, 4.5rem);
    margin-top: var(--section);
  }

  @media (min-width: 60rem) {
    .details {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .details section {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .details h2 {
    font-size: var(--step-subtitle);
    letter-spacing: -0.01em;
  }

  .details ul,
  .details ol {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
  }
</style>
