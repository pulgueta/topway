---
import { repositoryUrl } from "../config";

const current = Astro.url.pathname.replace(/\.html$/, "");
const links = [
  { href: "/download", label: "Download" },
  { href: "/privacy", label: "Privacy" },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Topway home">
      <picture>
        <source srcset="/images/topway-icon-dark.png" media="(prefers-color-scheme: dark)" />
        <img src="/images/topway-icon.png" alt="" width="32" height="32" />
      </picture>
      <span aria-hidden="true">Topway</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={current === href ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li><a href={repositoryUrl}>GitHub</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 0.75rem;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand img {
    width: 2rem;
    height: 2rem;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: 999px;
    color: var(--text);
    font-size: var(--step-small);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
    background: var(--stage);
  }

  nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--stage);
  }

  @media (max-width: 26rem) {
    .brand span {
      display: none;
    }

    nav a {
      padding-inline: 0.625rem;
    }
  }
</style>
